# Vite dev server for the Vue admin apps.
# Start it with `npm run dev`, then add this to wp-config.php so PHP loads
# assets from it instead of from dist/:
#
#   define( 'HMR_DEV', 'lisensio-kb' );
#
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=6913

# Base URL the Playwright suite runs against.
LISENSIO_KB_BASE_URL=http://lisenseserver.local

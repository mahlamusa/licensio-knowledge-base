{
    "name": "slswc/licensio-knowledge-base",
    "description": "Licensio Knowledge Base - WordPress documentation and self-service support plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "knowledge-base",
        "documentation"
    ],
    "authors": [
        {
            "name": "Lindeni Mahlalela",
            "email": "support@licenseserver.io"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "stellarwp/db": "^1.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "brianhenryie/strauss": "^0.19",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "classmap": [
            "includes/",
            "tests/Unit/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "strauss": {
            "target_directory": "libraries",
            "namespace_prefix": "Licensio_KB\\",
            "classmap_prefix": "Licensio_KB_",
            "constant_prefix": "LICENSIO_KB_",
            "include_modified_date": false,
            "delete_vendor_packages": false,
            "packages": [
                "stellarwp/db"
            ]
        }
    },
    "scripts": {
        "strauss": [
            "@php bin/run-strauss.php"
        ],
        "post-install-cmd": [
            "@strauss"
        ],
        "post-update-cmd": [
            "@strauss"
        ],
        "lint": "@php vendor/bin/phpcs",
        "fix": "@php vendor/bin/phpcbf",
        "analyze": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "unit": "@php vendor/bin/phpunit"
    }
}

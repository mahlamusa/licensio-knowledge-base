{
  "name": "lisensio-knowledge-base",
  "version": "1.0.0",
  "description": "Lisensio Knowledge Base - WordPress documentation and self-service support plugin.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:apps && npm run build:blocks",
    "build:apps": "node tools/build-apps.mjs",
    "build:blocks": "node tools/build-blocks.mjs",
    "release": "bash bin/build-release.sh",
    "release:github": "bash bin/github-release.sh",
    "version:bump": "bash bin/bump-version.sh",
    "wporg:publish": "bash bin/wp-org-publish.sh",
    "lint:js": "wp-scripts lint-js apps blocks assets/js --no-error-on-unmatched-pattern",
    "test": "playwright test --pass-with-no-tests",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@wordpress/scripts": "^30.0.0",
    "ant-design-vue": "^4.2.6",
    "chart.js": "^4.5.1",
    "pinia": "^2.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0"
  },
  "overrides": {
    "esbuild": "0.21.5"
  },
  "packageManager": "npm@11.10.0"
}

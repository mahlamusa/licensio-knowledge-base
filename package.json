{
  "name": "licensio-knowledge-base",
  "version": "1.0.0",
  "description": "Licensio Knowledge Base - WordPress documentation and self-service support plugin.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:apps && npm run build:blocks",
    "build:apps": "node tools/build-apps.mjs",
    "build:blocks": "node tools/build-blocks.mjs",
    "release": "bash bin/build-release.sh",
    "release:github": "bash bin/github-release.sh",
    "version:bump": "bash bin/bump-version.sh",
    "wporg:publish": "bash bin/wp-org-publish.sh",
    "lint:js": "wp-scripts lint-js apps blocks assets/js tests/Playwright tools playwright.config.ts vite.config.mjs eslint.config.mjs --ext .js,.mjs,.ts,.vue --no-error-on-unmatched-pattern",
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test --pass-with-no-tests",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "@wordpress/eslint-plugin": "^28.0.0",
    "@wordpress/scripts": "^37.0.0",
    "ant-design-vue": "^4.2.6",
    "chart.js": "^4.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "^16.5.0",
    "pinia": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "copy-webpack-plugin": {
      "serialize-javascript": "^7.1.4"
    },
    "markdownlint-cli": {
      "js-yaml": "^5.5.0",
      "katex": "^0.18.2",
      "smol-toml": "^1.9.1"
    }
  },
  "packageManager": "npm@11.10.0"
}

# Dependencies
/node_modules/
/vendor/

# Build output
/dist/
/build/
/releases/

# The translation template is generated into the release zips by
# bin/build-release.sh. Its line references and hashed dist/ file names change
# on every branch, so a committed copy only ever causes merge conflicts.
/languages/*.pot

# Test fixtures written into templates/ and block-templates/ by the template
# suite. Removed in tearDown; ignored here so an aborted run cannot leave one
# staged.
licensio-kb-test-fixture.*

# Tooling caches
.phpunit.result.cache
.phpcs-cache
/coverage/
/playwright-report/
/test-results/

# Orchestration + scratch
/.tmp/
/.epic-status
/.playwright-cli/

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Agent worktrees and local Claude state
/.claude/
.sandbox/

# Local specs (spec-interview / spec-loop)
/specs/
/.spec-status

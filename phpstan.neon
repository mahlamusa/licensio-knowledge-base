parameters:
    level: 5
    phpVersion: 70400
    paths:
        - licensio-knowledge-base.php
        - uninstall.php
        - includes
        - templates
        - tests
        # Nothing under tools/ ships, and phpcs.xml excludes it for that reason.
        # Static analysis is a different question: the disposable Heroic
        # migrator is referenced by tests/, which IS analysed, so leaving it out
        # would report every one of its classes as undefined. It is analysed at
        # the same level as everything else.
        - tools
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanDirectories:
        - libraries
    scanFiles:
        - libraries/autoload.php
    dynamicConstantNames:
        - LICENSIO_KB_ABSPATH
        - LICENSIO_KB_PLUGIN_URL
        - LICENSIO_KB_DIST_URL
        - LICENSIO_KB_DIST_PATH
        - HMR_DEV
        - WP_CLI
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

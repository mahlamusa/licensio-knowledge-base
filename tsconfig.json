{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [ "ES2022", "DOM", "DOM.Iterable" ],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": [ "node" ]
	},
	"include": [
		"apps/**/*.ts",
		"apps/**/*.vue",
		"tests/Playwright/**/*.ts",
		"playwright.config.ts"
	]
}

# Dependencies
/node_modules/
/vendor/

# Build output
/dist/
/build/
/releases/

# Test fixtures written into templates/ and block-templates/ by the template
# suite. Removed in tearDown; ignored here so an aborted run cannot leave one
# staged.
licensio-kb-test-fixture.*

# Tooling caches
.phpunit.result.cache
.phpcs-cache
/coverage/
/playwright-report/
/test-results/

# Orchestration + scratch
/.tmp/
/.epic-status
/.playwright-cli/

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Agent worktrees and local Claude state
/.claude/


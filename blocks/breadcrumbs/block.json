{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "licensio-kb/breadcrumbs",
	"title": "Knowledge Base Breadcrumbs",
	"category": "licensio-kb",
	"icon": "menu",
	"description": "The trail from the site home down to the article or category being viewed.",
	"keywords": [ "breadcrumbs", "knowledge base", "navigation", "trail" ],
	"textdomain": "licensio-knowledge-base",
	"supports": {
		"html": false,
		"customClassName": false,
		"reusable": true
	},
	"attributes": {
		"showHome": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "licensio-kb-blocks",
	"editorStyle": "licensio-kb-blocks-editor"
}

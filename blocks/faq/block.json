{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "licensio-kb/faq",
	"title": "Knowledge Base FAQ",
	"category": "licensio-kb",
	"icon": "editor-help",
	"description": "Knowledge base articles as an expandable list of questions and answers.",
	"keywords": [ "faq", "questions", "accordion", "knowledge base" ],
	"textdomain": "licensio-knowledge-base",
	"supports": {
		"html": false,
		"customClassName": false,
		"reusable": true
	},
	"attributes": {
		"category": {
			"type": "string",
			"default": ""
		},
		"orderBy": {
			"type": "string",
			"default": "menu_order"
		},
		"order": {
			"type": "string",
			"default": "asc"
		},
		"count": {
			"type": "number",
			"default": 10
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"openFirst": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js",
	"style": "licensio-kb-blocks",
	"editorStyle": "licensio-kb-blocks-editor"
}

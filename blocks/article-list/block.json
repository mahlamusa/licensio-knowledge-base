{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "licensio-kb/article-list",
	"title": "Knowledge Base Articles",
	"category": "licensio-kb",
	"icon": "list-view",
	"description": "A list of knowledge base articles, optionally filtered to one category.",
	"keywords": [ "knowledge base", "articles", "documentation", "help" ],
	"textdomain": "licensio-knowledge-base",
	"supports": {
		"html": false,
		"customClassName": false,
		"reusable": true
	},
	"attributes": {
		"category": {
			"type": "string",
			"default": ""
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"count": {
			"type": "number",
			"default": 5
		},
		"columns": {
			"type": "number",
			"default": 1
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "licensio-kb-blocks",
	"editorStyle": "licensio-kb-blocks-editor"
}
